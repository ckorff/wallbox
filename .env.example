# Django core
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
# Comma-separated list, e.g. localhost,127.0.0.1,wallbox.lan
ALLOWED_HOSTS=localhost,127.0.0.1

# Email / SMTP — leave EMAIL_HOST empty to use the console backend
# (mails are printed to stdout instead of being sent).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=wallbox@example.com

# Recipient of the monthly report (work email).
REPORT_RECIPIENT_EMAIL=

# KEBA P30 x wallbox — Modbus TCP
KEBA_HOST=
KEBA_PORT=502
