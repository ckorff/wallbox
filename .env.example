# Django core
SECRET_KEY=replace-me-with-a-long-random-string
DEBUG=True
# Comma-separated list, e.g. localhost,127.0.0.1,wallbox.lan
ALLOWED_HOSTS=localhost,127.0.0.1

# Email / SMTP — leave EMAIL_HOST empty to use the console backend
# (mails are printed to stdout instead of being sent).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=wallbox@example.com

# Recipient of the monthly report (work email).
REPORT_RECIPIENT_EMAIL=

# KEBA P30 x wallbox — Modbus TCP (used for live status only)
KEBA_HOST=
KEBA_PORT=502

# OCPP 1.6-J server. The wallbox connects out to this address and is the
# source of truth for charging-session capture. Configure the wallbox to
# use ws://<this-host>:<port>/ocpp/<chargeBoxId> with the basic-auth
# credentials below.
OCPP_LISTEN_HOST=0.0.0.0
OCPP_LISTEN_PORT=9000
OCPP_BASIC_AUTH_USERNAME=keba-home
OCPP_BASIC_AUTH_PASSWORD=replace-me-with-a-long-random-string
