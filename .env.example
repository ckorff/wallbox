# Django core
SECRET_KEY=replace-me-with-a-long-random-string
# Production default. Set to True only for local dev.
DEBUG=False
# Comma-separated. Add the box's LAN hostname/IP if reaching it from another host,
# e.g. localhost,127.0.0.1,wallbox.lan,192.168.1.42
ALLOWED_HOSTS=localhost,127.0.0.1

# Email / SMTP — leave EMAIL_HOST empty to use the console backend
# (mails are printed to stdout instead of being sent).
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=wallbox@example.com

# Recipient of the monthly report (work email).
REPORT_RECIPIENT_EMAIL=

# KEBA P30 x wallbox — HTTP CSV export via the web GUI.
# The username/password are the ones you use to log in to the wallbox in a browser.
KEBA_HOST=
KEBA_USERNAME=
KEBA_PASSWORD=

# Reporter and vehicle profile — appears on every monthly PDF report.
# All values are required; missing keys raise ImproperlyConfigured at startup.
# CHARGING_LOCATION may be multi-line; use \n to insert line breaks.
REPORTER_NAME=Jane Doe
REPORTER_EMPLOYEE_ID=000000
VEHICLE_MAKE_MODEL=Make Model
VEHICLE_LICENSE_PLATE=AB CD 1234
CHARGING_LOCATION=Example Street 1\n12345 Example City, Country
