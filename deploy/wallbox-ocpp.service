[Unit]
Description=Wallbox OCPP 1.6-J server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ckorff
WorkingDirectory=/home/ckorff/projects/wallbox
ExecStart=/home/ckorff/projects/wallbox/.venv/bin/python manage.py ocpp_serve
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
